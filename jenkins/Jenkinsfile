pipeline {

    agent any

    stages {

        stage('Project Information') {

            steps {

                echo 'Starting Company DevOps Project Pipeline'

            }

        }

        stage('Check Workspace') {

            steps {

                sh 'pwd'
                sh 'ls'
                sh 'ls -R'

            }

        }

        stage('Check Docker') {

            steps {

                sh 'docker --version'

            }

        }

        stage('Build Docker Image') {

            steps {

                sh 'pwd'
                sh 'ls -R'

            }

        }

    }

}
